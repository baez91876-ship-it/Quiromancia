        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"User MassPost\",\n  \"email\": \"masspost@example.com\",\n  \"fechaNacimiento\": \"1990-01-01\",\n  \"genero\": \"M\",\n  \"telefono\": \"3000000000\",\n  \"password\": \"password123\",\n  \"rol\": \"admin\",\n  \"esAdministrador\": true\n}",
