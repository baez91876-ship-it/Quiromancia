        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario_id\": \"60d5ec49f1b2c81111111111\",\n  \"prompt_usado_id\": \"60d5ec49f1b2c82222222222\",\n  \"respuesta\": \"Test\",\n  \"analisis\": \"Test\",\n  \"metadata\": { \"fuente\": \"test\" },\n  \"resultado\": \"Test\"\n}",
          "options": { "raw": { "language": "json" } }
