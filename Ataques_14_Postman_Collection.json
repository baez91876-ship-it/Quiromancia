          "path": ["usuarios", "60d5ec49f1b2c81111111111"]
        }
      }
    },
    {
      "name": "11. Método que no existe",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{base_url}}/usuarios",
          "host": ["{{base_url}}"],
          "path": ["usuarios"]
        }
      }
    },
    {
