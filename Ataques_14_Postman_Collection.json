        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/usuarios",
          "host": ["{{base_url}}"],
          "path": ["usuarios"]
        }
      }
    },
