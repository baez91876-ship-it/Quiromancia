          "raw": "{{base_url}}/lecturasIA",
          "host": ["{{base_url}}"],
          "path": ["lecturasIA"]
        }
      }
    },
    {
      "name": "13. Borrar algo con dependencias",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{base_url}}/usuarios/{{usuario_id_con_lecturas}}",
          "host": ["{{base_url}}"],
          "path": ["usuarios", "{{usuario_id_con_lecturas}}"]
        }
      }
    },
    {
      "name": "14. Actualizar solo un campo",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Nombre Solo Parcial\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/usuarios/{{usuario_id}}",
          "host": ["{{base_url}}"],
          "path": ["usuarios", "{{usuario_id}}"]
