          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/usuarios/{{usuario_id}}",
          "host": ["{{base_url}}"],
          "path": ["usuarios", "{{usuario_id}}"]
        }
      }
    },
    {
      "name": "9. Id que no es un id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/usuarios/123abc",
          "host": ["{{base_url}}"],
          "path": ["usuarios", "123abc"]
        }
      }
    },
    {
      "name": "10. Id válido que no existe",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/usuarios/60d5ec49f1b2c81111111111",
