{
  "info": {
    "name": "Numerologia API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección para probar Numerologia API con los casos requeridos del enunciado."
  },
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if (!pm.environment.get('user_email')) {",
                  "    pm.environment.set('user_email', `test.${Math.random().toString(36).substring(2,10)}@example.com`);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('usuario_id', data._id);",
                  "pm.test('Email created matches environment email', function () { pm.expect(data.email).to.eql(pm.environment.get('user_email')); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Test Usuario\",\n  \"email\": \"{{user_email}}\",\n  \"fechaNacimiento\": \"1990-01-01\",\n  \"genero\": \"M\",\n  \"telefono\": \"5551234567\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Crear usuario duplicado (validación unicidad)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error contains email', function () { pm.expect(JSON.stringify(pm.response.json()).toLowerCase()).to.include('email'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Test Usuario Duplicado\",\n  \"email\": \"{{user_email}}\",\n  \"fechaNacimiento\": \"1990-01-01\",\n  \"genero\": \"M\",\n  \"telefono\": \"5551234567\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Crear usuario sin matriz",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.environment.set('usuario_id_no_matriz', data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Sin Matriz\",\n  \"email\": \"test.nomatriz.{{$randomInt}}@example.com\",\n  \"fechaNacimiento\": \"1990-01-01\",\n  \"genero\": \"F\",\n  \"telefono\": \"5550000000\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          }
        },
        {
          "name": "Obtener usuario por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Usuario returned matches env id', function () { pm.expect(data._id).to.eql(pm.environment.get('usuario_id')); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/usuarios/{{usuario_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios", "{{usuario_id}}"
              ]
            }
          }
        }
      ]
