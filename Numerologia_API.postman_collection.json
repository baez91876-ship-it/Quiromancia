        },
        {
          "name": "Obtener matriz con populate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('usuario_id is populated object', function () { pm.expect(data.usuario_id).to.be.an('object'); });",
                  "pm.test('populate object id matches usuario_id', function () { pm.expect(data.usuario_id._id).to.eql(pm.environment.get('usuario_id')); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/matricesNumerologicas/completa/{{matriz_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "matricesNumerologicas", "completa", "{{matriz_id}}"
