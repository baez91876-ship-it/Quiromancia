            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('usuario_id is raw ObjectId string', function () { pm.expect(data.usuario_id).to.be.a('string'); });"
                ],
